const MIN_BID_PREFIX := "La mise minimale est de "


static func t(fr: String) -> String:
	if language != "en":
		return fr
	if EN.has(fr):
		return EN[fr]
	if fr.begins_with(MIN_BID_PREFIX):
		return "The minimum bid is " + fr.substr(MIN_BID_PREFIX.length()).rstrip(".")  + "."
	if fr.begins_with("Erreur du serveur ("):
		return "Server error (" + fr.substr(19)
	return fr
